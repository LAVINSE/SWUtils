/* Foldout */
.sw-foldout {
    background-color: rgba(0, 0, 0, 0.12);
    margin-top: 5px;
    margin-bottom: 5px;
    border-left-color: black;
    border-left-width: 3px;
    padding-right: 10px;
    padding-left: 0;
    padding-bottom: 0;
    padding-top: 0;
}

/* Foldout header bar */
.sw-foldout > Toggle.sw-foldout-toggle {
    background-color: rgba(0, 0, 0, 0.12);
    padding-top: 5px;
    padding-left: 10px;
    margin-left: 0;
    padding-bottom: 5px;
    margin-bottom: 0;
    -unity-font-style: bold;
}

/* Foldout contents */
.sw-foldout > #unity-content {
    padding-top: 5px;
    margin-top: 0;
    margin-left: 10px;
    padding-left: 10px;
    padding-bottom: 10px;
}

/* [Header] attributes */
.sw-foldout .unity-header-drawer__label {
    margin-top: 10px;
    padding-bottom: 5px;
    padding-top: 5px;
    margin-left: -20px;
    padding-left: 20px;
    -unity-font-style: bold;
    background-color: rgba(255, 255, 255, 0.04);
}

/* Iris Line: 공통 컨트롤의 색상과 크기를 인스펙터에 맞춥니다. */
.sw-theme.sw-inspector-theme {
    --sw-background: #24252b;
    --sw-panel: #2c2e38;
    --sw-toolbar: #2c2e38;
    --sw-card: #2c2e38;
    --sw-input: #373a47;
    --sw-border: #494c5b;
    --sw-text: #eaeaf2;
    --sw-muted: #b5b8cb;
    --sw-accent: #b3acee;
    --sw-hover: #3e4050;
    --sw-selection: #46425f;
    --sw-font-body: 13px;
    --sw-control-height: 28px;
    padding: 6px 8px 10px 8px;
    min-width: 0;
}

.sw-theme.sw-inspector-theme .sw-foldout {
    margin: 8px 0;
    border-radius: 3px;
    border-left-width: 3px;
}

.sw-theme.sw-inspector-theme .sw-foldout > Toggle.sw-foldout-toggle {
    min-height: 32px;
    padding: 5px 8px;
}

.sw-theme.sw-inspector-theme .sw-foldout > Toggle.sw-foldout-toggle .unity-foldout__text {
    font-size: 14px;
}

.sw-theme.sw-inspector-theme .sw-foldout > #unity-content {
    padding: 6px 8px 8px 8px;
    margin-left: 0;
}

.sw-theme.sw-inspector-theme .unity-base-field {
    margin: 3px 0;
}

.sw-theme.sw-inspector-theme .unity-base-field__label {
    min-width: 64px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.sw-theme.sw-inspector-theme .unity-base-text-field__input,
.sw-theme.sw-inspector-theme .unity-popup-field__input,
.sw-theme.sw-inspector-theme .unity-enum-field__input,
.sw-theme.sw-inspector-theme .unity-object-field__input {
    padding: 3px 6px;
    border-radius: 3px;
}

.sw-theme.sw-inspector-theme .unity-object-field__input {
    padding-right: 0;
}

.sw-theme.sw-inspector-theme .unity-composite-field__field .unity-base-field__label {
    min-width: 12px;
    padding: 0 3px;
    white-space: nowrap;
}

.sw-theme.sw-inspector-theme .unity-foldout__toggle {
    min-height: 28px;
}

.sw-theme.sw-inspector-theme .unity-button,
.sw-theme.sw-inspector-theme .unity-toolbar-button {
    height: auto;
    min-height: 28px;
    padding: 4px 8px;
    white-space: normal;
}

.sw-theme.sw-inspector-theme .sw-attribute-toolbar {
    height: auto;
    min-height: 32px;
    flex-wrap: wrap;
    padding: 2px 0;
    border-width: 0;
    background-color: transparent;
}

.sw-theme.sw-inspector-theme .sw-attribute-toolbar .unity-toolbar-button {
    min-width: 72px;
    flex-basis: 0;
    flex-shrink: 1;
}

.sw-theme.sw-inspector-theme .unity-list-view__footer {
    min-height: 30px;
}

.sw-theme.sw-inspector-theme .unity-list-view__footer .unity-button {
    min-height: 26px;
    padding: 2px 8px;
}

.sw-theme.sw-inspector-theme .unity-help-box {
    padding: 8px;
}

/* Button toolbars */
.sw-toolbar {
    margin-top: 5px;
    border-width: 0px;
    
}

.sw-toolbar ToolbarButton {
    border-width: 1px;
    -unity-text-align: middle-center;
}

.sw-toolbar ToolbarButton.main-call-to-action {
    background-color: rgba(30, 94, 88, 1);
    color: white;
    -unity-text-align: middle-center;
}

.sw-fixed-width-floatfield FloatInput TextElement
{
    width: 50px;
}

.sw-fixed-width-floatfield Label
{
    min-width: 50px;
}

    /* Spring */

.sw-spring-debug-track-background
{
    margin-top: 5px;
    background-color: rgba(0, 0, 0, 0.5);
    height: 20px;
    width: 100%;
    flex-direction: row;
    justify-content: flex-start;
}

.sw-spring-debug-track-foreground
{
    background-color: rgba(255, 196, 0, 1);
    height: 20px;
    width: 10px;
    margin-top: -20px;    
}

.sw-spring-debug-track-foreground-container-left
{
    background-color: green;
    height: 20px;
    width: 50%;
    left: 0px;
    margin-top: -20px;
    display: flex;
    justify-content: flex-end;
}

.sw-spring-debug-track-foreground-container-right
{
    background-color: blue;
    height: 20px;
    width: 50%;
    left: 50%;
    margin-top: -20px;
    display: flex;
    justify-content: flex-end;
}

.sw-button-container {
    margin-top: 10px;
    margin-bottom: 5px;
}

.sw-button {
    height: 24px;
    margin: 2px 0;
    -unity-font-style: bold;
}

.sw-button:hover {
    background-color: #4a4a4a;
}
